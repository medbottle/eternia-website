RewriteCond %{HTTP_HOST} ^chronicles\-of\-esshar\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.chronicles\-of\-esshar\.com$
RewriteRule ^/?$ "https\:\/\/chronicles\-of\-eternia\.com\/" [R=301,L]

RewriteEngine On

RewriteRule ^/?wiki(/.*)?$ %{DOCUMENT_ROOT}/w/index.php [L]

RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|anthropic-ai|Bytespider|CCBot|PerplexityBot|Amazonbot|Meta-ExternalAgent|Meta-ExternalFetcher|Applebot-Extended|Diffbot|ImagesiftBot|Omgili|YouBot|cohere-ai|Timpibot|DuckAssistBot) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|DotBot|MJ12bot|Barkrowler|BLEXBot|DataForSeoBot|SerpstatBot|SeznamBot|PetalBot|ZoominfoBot|MegaIndex|LinkpadBot|Sogou|YisouSpider) [NC]
RewriteRule .* - [F,L]

<Files 403.shtml>
order allow,deny
allow from all
</Files>

deny from 74.7.227.143

# BEGIN static homepage (eternia-website repo)
ErrorDocument 404 /404.html

# Caching applies to the homepage's own files only, so wiki/forum headers are untouched.
# File names aren't versioned, so CSS/JS revalidate on every load (cheap 304s);
# images, fonts and the hero video are cached for a week.
<IfModule mod_headers.c>
	<If "%{REQUEST_URI} =~ m#^/(css|js)/#">
		Header set Cache-Control "no-cache"
	</If>
	<ElseIf "%{REQUEST_URI} =~ m#^/(img|fonts)/|^/hero\.mp4$#">
		Header set Cache-Control "public, max-age=604800"
	</ElseIf>
</IfModule>
# END static homepage

